FS_ENV=pilot
FS_CHANNEL=pilot
FS_DB_PATH=/var/lib/fieldscan/catalog.sqlite3
FS_DATA_DIR=/var/lib/fieldscan
FS_SQLITE_JOURNAL_MODE=DELETE
FS_API_TOKEN_SHA256=REEMPLAZAR_DIGEST_HEX_DE_64
FS_LOG_LEVEL=INFO
# Optional Remote Multimodal Assistant Proxy for iPad (API key stays server-side only)
FS_ASSISTANT_ENABLED=false
FS_ASSISTANT_PROVIDER=bedrock_mantle
FS_BEDROCK_REGION=us-east-1
FS_ASSISTANT_API_URL=https://bedrock-mantle.us-east-1.api.aws/v1/chat/completions
FS_ASSISTANT_MODEL=moonshotai.kimi-k2.5
FS_ASSISTANT_API_KEY=
FS_ASSISTANT_TIMEOUT_SEC=30.0
FS_ASSISTANT_MAX_BODY_BYTES=2000000
FS_ASSISTANT_MAX_TOKENS=512

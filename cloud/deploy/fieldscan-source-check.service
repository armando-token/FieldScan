[Unit]
Description=FieldScan Cloud periodic OEM source recheck
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fieldscan
Group=fieldscan
WorkingDirectory=/opt/fieldscan/current/cloud
EnvironmentFile=/etc/fieldscan/worker.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fieldscan/current/cloud/.venv/bin/python -m fieldscan_cloud.cli check-sources --db /var/lib/fieldscan/catalog.sqlite3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fieldscan
UMask=0077

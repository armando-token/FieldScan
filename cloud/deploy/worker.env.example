FS_ENV=pilot
FS_CHANNEL=pilot
FS_DB_PATH=/var/lib/fieldscan/catalog.sqlite3
FS_DATA_DIR=/var/lib/fieldscan
FS_SQLITE_JOURNAL_MODE=DELETE
FS_SIGNING_KEY_ID=pilot-1
FS_ISSUER=fieldscan-pilot
FS_GLTF_VALIDATOR=/opt/fieldscan/bin/gltf_validator
FS_CONTEXT_ENABLED=true
FS_CONTEXT_SEARCH_URL=https://api.context.dev/v1/web/search
CONTEXT_DEV_API_KEY=REEMPLAZAR_CLAVE_CONTEXT
FS_CONTEXT_MAX_RESULTS=10
FS_IMAGE_HARVEST_ENABLED=true
FS_VLM_ENABLED=false
# Supported providers: bedrock_mantle | bedrock | openai_compatible | gemini | anthropic
FS_VLM_PROVIDER=bedrock_mantle
FS_BEDROCK_REGION=us-east-1
FS_VLM_API_URL=https://bedrock-mantle.us-east-1.api.aws/v1/chat/completions
FS_VLM_MODEL=mistral.mistral-large-3-675b-instruct
FS_VLM_API_KEY=
FS_VLM_VISUAL_REVIEW=false
FS_VLM_MIN_VISUAL_SCORE=0.70
FS_MAX_JOB_ATTEMPTS=3
FS_JOB_LEASE_SEC=180
FS_LOG_LEVEL=INFO
